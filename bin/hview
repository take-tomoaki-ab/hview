#!/usr/bin/env bash
# hview の実行エントリ。bun が PATH に無い環境でも動くよう、既知の場所も探す。
set -euo pipefail
# 呼び出し元の cwd ではなく、hview 自身が置かれている場所を求める。
# README が ~/.local/bin へのシンボリックリンクを勧めているので、リンクは最後まで辿る。
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  DIR="$(cd -P -- "$(dirname -- "$SRC")" && pwd)"
  SRC="$(readlink -- "$SRC")"
  case "$SRC" in /*) ;; *) SRC="$DIR/$SRC" ;; esac
done
HERE="$(cd -P -- "$(dirname -- "$SRC")" && pwd)"

if command -v bun >/dev/null 2>&1 && bun --version >/dev/null 2>&1; then
  BUN="$(command -v bun)"
elif [ -x "$HOME/.bun/bin/bun" ]; then
  BUN="$HOME/.bun/bin/bun"
else
  BUN="$(ls -d "$HOME"/.asdf/installs/bun/*/bin/bun 2>/dev/null | sort -V | tail -1 || true)"
fi

if [ -z "${BUN:-}" ] || [ ! -x "$BUN" ]; then
  echo "hview: bun が見つかりません。https://bun.sh からインストールしてください。" >&2
  exit 127
fi

exec "$BUN" run "$HERE/../src/cli.ts" "$@"
